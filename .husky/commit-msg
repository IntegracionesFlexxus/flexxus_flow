#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Validar formato del mensaje de commit
commit_regex="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .{1,100}"

if ! grep -qE "$commit_regex" "$1"; then
    echo "❌ Mensaje de commit inválido!"
    echo "📝 Formato: <type>(<scope>): <subject>"
    echo "📚 Types válidos: feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert"
    echo ""
    echo "Ejemplos:"
    echo "  feat(auth): agregar autenticación con JWT"
    echo "  fix(api): corregir error en endpoint de usuarios"
    echo "  docs: actualizar README con instrucciones de instalación"
    exit 1
fi

echo "✅ Mensaje de commit válido"