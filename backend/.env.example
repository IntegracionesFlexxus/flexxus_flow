# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration - Shared
DB_SHARED_HOST=localhost
DB_SHARED_PORT=5432
DB_SHARED_NAME=flexxus_shared
DB_SHARED_USER=postgres
DB_SHARED_PASSWORD=your_password_here

# Database Configuration - Omni
DB_OMNI_HOST=localhost
DB_OMNI_PORT=5432
DB_OMNI_NAME=flexxus_omni
DB_OMNI_USER=postgres
DB_OMNI_PASSWORD=your_password_here

# Database Configuration - Personas
DB_PERSONAS_HOST=localhost
DB_PERSONAS_PORT=5432
DB_PERSONAS_NAME=flexxus_personas
DB_PERSONAS_USER=postgres
DB_PERSONAS_PASSWORD=your_password_here

# Database Configuration - Notificaciones
DB_NOTIFICACIONES_HOST=localhost
DB_NOTIFICACIONES_PORT=5432
DB_NOTIFICACIONES_NAME=flexxus_notificaciones
DB_NOTIFICACIONES_USER=postgres
DB_NOTIFICACIONES_PASSWORD=your_password_here

# Database Configuration - Organizaciones
DB_ORGANIZACIONES_HOST=localhost
DB_ORGANIZACIONES_PORT=5432
DB_ORGANIZACIONES_NAME=flexxus_organizaciones
DB_ORGANIZACIONES_USER=postgres
DB_ORGANIZACIONES_PASSWORD=your_password_here

# Database Pool Configuration
DB_MAX_RETRIES=3
DB_RETRY_DELAY=1000
DB_POOL_SIZE=10

# Security Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# API Keys (format: key1:service1,key2:service2)
API_KEYS=dev_key_1:frontend,dev_key_2:mobile,dev_key_3:admin

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=logs
LOG_FILENAME=app-%DATE%.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Cache Configuration
CACHE_DEFAULT_TTL=300
CACHE_CHECK_PERIOD=600
CACHE_MAX_KEYS=1000

# Redis Configuration (optional - for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Microservices URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
COMPANY_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
REPORT_SERVICE_URL=http://localhost:3005

# Health Check Configuration
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=5000

# Email Service (for future use)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# AWS Configuration (for future use)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=flexxus-uploads

# Monitoring (for future use)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
DATADOG_API_KEY=