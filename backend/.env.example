# Environment Configuration
NODE_ENV=development

# Application
APP_NAME=flexxus-flow
APP_VERSION=2.0.0
PORT=3000
HOST=localhost
API_PREFIX=/api/v1

# PostgreSQL Database Connections
# Shared DB
SHARED_DB_HOST=localhost
SHARED_DB_PORT=5432
SHARED_DB_NAME=shared_db
SHARED_DB_USER=postgres
SHARED_DB_PASSWORD=postgres123
SHARED_DB_SSL=false
SHARED_DB_POOL_MIN=2
SHARED_DB_POOL_MAX=20

# Omni DB
OMNI_DB_HOST=localhost
OMNI_DB_PORT=5432
OMNI_DB_NAME=omni_db
OMNI_DB_USER=postgres
OMNI_DB_PASSWORD=postgres123

# CRM DB
CRM_DB_HOST=localhost
CRM_DB_PORT=5432
CRM_DB_NAME=flexxus_crm
CRM_DB_USER=postgres
CRM_DB_PASSWORD=postgres123

# Workflow DB
WORKFLOW_DB_HOST=localhost
WORKFLOW_DB_PORT=5432
WORKFLOW_DB_NAME=flexxus_workflow
WORKFLOW_DB_USER=postgres
WORKFLOW_DB_PASSWORD=postgres123

# Analytics DB
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=flexxus_analytics
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=postgres123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flexxus:
REDIS_TTL=3600

# JWT
JWT_SECRET=flexxus_jwt_secret_key_temporal_sprint2_enhanced_auth
JWT_REFRESH_SECRET=flexxus_jwt_refresh_secret_key_temporal_sprint2_auth
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=flexxus-sistema-gestion
JWT_AUDIENCE=flexxus-sistema-gestion-client
JWT_ALGORITHM=HS256

# Session
SESSION_SECRET=flexxus_session_secret_key_temporal_sprint2
SESSION_NAME=flexxus.sid
SESSION_COOKIE_MAX_AGE=604800000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIRECTORY=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
AUDIT_LOG_ENABLED=true

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=false
RATE_LIMIT_SKIP_FAILED=false

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Email
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@flexxus-flow.com

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOAD_DIR=./uploads
STORAGE_LOCAL_TEMP_DIR=./temp
STORAGE_MAX_FILE_SIZE=10485760

# Cache
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_KEYS=500
CACHE_CHECK_PERIOD=600

# Queue
QUEUE_ENABLED=false
QUEUE_PROVIDER=bull

# Monitoring
MONITORING_ENABLED=false
METRICS_PORT=9090
HEALTH_CHECK_PATH=/health

# Feature Flags
FEATURE_FLAGS_ENABLED=true
FEATURE_FLAGS_CACHE_TTL=300

# Security Keys
MASTER_KEY=change-this-master-key-in-production
AUDIT_SIGNING_KEY=change-this-signing-key-in-production
SECRETS_MASTER_KEY=change-this-secrets-key-in-production
SECRETS_SALT=change-this-salt-in-production

# Email Extended
FROM_EMAIL=noreply@flexxusflow.com
FROM_NAME=FlexxusFlow
SUPPORT_EMAIL=support@flexxusflow.com
LOG_EMAIL_CONTENT=false
SMTP_PASS=

# WebSocket
WEBSOCKET_PORT=3001
WEBSOCKET_ENABLED=true