# === ENVIRONMENT ===
NODE_ENV=development
PORT=3000
APP_NAME=Flexxus Flow

# === DATABASE CONFIGURATION ===
# Shared Database
SHARED_DB_HOST=localhost
SHARED_DB_PORT=5432
SHARED_DB_NAME=flexxus_shared
SHARED_DB_USER=flexxus_user
SHARED_DB_PASSWORD=your_password_here
SHARED_DB_SSL=false

# Omnichannel Database
OMNI_DB_HOST=localhost
OMNI_DB_PORT=5432
OMNI_DB_NAME=flexxus_omni
OMNI_DB_USER=flexxus_user
OMNI_DB_PASSWORD=your_password_here
OMNI_DB_SSL=false

# CRM Database
CRM_DB_HOST=localhost
CRM_DB_PORT=5432
CRM_DB_NAME=flexxus_crm
CRM_DB_USER=flexxus_user
CRM_DB_PASSWORD=your_password_here
CRM_DB_SSL=false

# Workflow Database
WORKFLOW_DB_HOST=localhost
WORKFLOW_DB_PORT=5432
WORKFLOW_DB_NAME=flexxus_workflow
WORKFLOW_DB_USER=flexxus_user
WORKFLOW_DB_PASSWORD=your_password_here
WORKFLOW_DB_SSL=false

# Analytics Database
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=flexxus_analytics
ANALYTICS_DB_USER=flexxus_user
ANALYTICS_DB_PASSWORD=your_password_here
ANALYTICS_DB_SSL=false

# === SECURITY ===
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
API_KEY_PREFIX=flx_

# === CORS ===
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# === LOGGING ===
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# === CACHE ===
CACHE_ENABLED=true
CACHE_TTL=300
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === EMAIL ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@flexxusflow.com

# === EXTERNAL SERVICES ===
# WhatsApp
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=your_whatsapp_token

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_API_URL=https://api.telegram.org

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# === FILE STORAGE ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# === MONITORING ===
SENTRY_DSN=
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# === FEATURE FLAGS ===
FEATURE_REGISTRATION_ENABLED=true
FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_API_DOCS=true

# === MISCELLANEOUS ===
TIMEZONE=America/Mexico_City
DEFAULT_LANGUAGE=es
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100