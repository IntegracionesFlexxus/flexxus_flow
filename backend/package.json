{
  "name": "flexxus-backend",
  "version": "1.0.0",
  "description": "Flexxus Flow Backend - Sprint 2",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:performance": "jest --testPathPattern=performance",
    "test:security": "jest --testPathPattern=security",
    "test:coverage": "jest --coverage",
    "test:coverage:html": "jest --coverage --coverageReporters=html",
    "test:coverage:report": "node scripts/generate-coverage-report.js",
    "test:coverage:check": "jest --coverage --coverageReporters=json-summary && node scripts/check-coverage.js",
    "coverage:view": "open coverage/index.html",
    "test:ci": "jest --ci --coverage --maxWorkers=50%",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "quality:fix": "npm run lint:fix && npm run format",
    "docs:generate": "typedoc",
    "docs:serve": "npx http-server ./docs -p 8080",
    "prepare": "cd .. && husky install backend/.husky || true",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down",
    "db:status": "node scripts/migrate.js status",
    "db:create": "node scripts/migrate.js create",
    "db:reset": "node scripts/migrate.js reset",
    "clean": "rimraf dist coverage docs",
    "prebuild": "npm run clean",
    "pretest": "npm run quality"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron": "^4.3.3",
    "csurf": "^1.11.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.2.1",
    "file-type": "^18.7.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "html-to-text": "^9.0.5",
    "inversify": "^6.0.2",
    "inversify-express-utils": "^6.5.0",
    "ioredis": "^5.3.2",
    "isomorphic-dompurify": "^1.9.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "juice": "^11.0.1",
    "lodash": "^4.17.21",
    "mjml": "^4.15.3",
    "module-alias": "^2.2.3",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "puppeteer": "^24.22.3",
    "rate-limiter-flexible": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.1",
    "socket.io-redis": "^6.1.1",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^3.15.9",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.16",
    "@types/cron": "^2.0.1",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.201",
    "@types/mjml": "^4.7.4",
    "@types/multer": "^1.4.10",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "@types/reflect-metadata": "^0.0.5",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^2.0.16",
    "@types/validator": "^13.11.6",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "axios-mock-adapter": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "_moduleAliases": {
    "@": "dist",
    "@config": "dist/config",
    "@interfaces": "dist/interfaces",
    "@services": "dist/services",
    "@repositories": "dist/repositories",
    "@controllers": "dist/controllers",
    "@middlewares": "dist/middlewares",
    "@utils": "dist/utils",
    "@container": "dist/container",
    "@models": "dist/models",
    "@modules": "dist/modules",
    "@shared": "dist/shared",
    "@core": "dist/core",
    "@entities": "dist/entities"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flexxus/flexxus-flow.git"
  },
  "keywords": [
    "flexxus",
    "backend",
    "typescript",
    "express",
    "typeorm",
    "testing"
  ],
  "author": "Flexxus Team",
  "license": "PROPRIETARY",
  "private": true
}
