# Environment variables - MVP Nivel 1
# Copy this file to .env.local for local development
# TODO: En Nivel 2 agregar más configuraciones, feature flags, analytics keys

# Application
VITE_APP_NAME=Flexxus Flow
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:3001
VITE_WS_RECONNECT_ATTEMPTS=5
VITE_WS_RECONNECT_DELAY=5000

# Auth Configuration
VITE_AUTH_TOKEN_KEY=flexxus_token
VITE_AUTH_REFRESH_TOKEN_KEY=flexxus_refresh_token
VITE_AUTH_SESSION_TIMEOUT=3600000

# Storage Keys
VITE_STORAGE_PREFIX=flexxus_

# Feature Flags
VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_REAL_TIME=true
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_DEBUG=true

# External Services (TODO: Implementar en Nivel 2)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_INTERCOM_APP_ID=

# Build Configuration
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true

# Public URL (para assets)
VITE_PUBLIC_URL=/