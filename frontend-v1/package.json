{
  "name": "flexxus-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc && vite build",
    "build:prod": "NODE_ENV=production npm run build",
    "build:staging": "NODE_ENV=staging npm run build",
    "build:analyze": "ANALYZE=true vite build",
    "build:docker": "docker build -t flexxus-frontend .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "preview:prod": "vite preview --port 4173",
    "test": "echo \"No tests configured yet - TODO: Add in Level 2\"",
    "clean": "rm -rf dist node_modules .vite",
    "clean:cache": "rm -rf node_modules/.vite",
    "analyze": "npm run build:analyze && npx serve dist",
    "bundle-report": "npx vite-bundle-visualizer",
    "perf:lighthouse": "npx lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "perf:bundle-size": "npx size-limit",
    "perf:check": "npm run type-check && npm run lint && npm run build",
    "deploy:check": "npm run lint && npm run type-check && npm run format:check",
    "deploy:build": "npm run clean && npm run build:prod",
    "serve:dist": "npx serve -s dist -l 3000",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^5.2.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/lab": "^5.0.0-alpha.173",
    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^6.18.0",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-query-devtools": "^5.87.3",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.6.2",
    "date-fns": "^3.6.0",
    "formik": "^2.4.6",
    "framer-motion": "^10.18.0",
    "immer": "^10.1.3",
    "lucide-react": "^0.542.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^6.20.1",
    "react-use-measure": "^2.1.7",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "yup": "^1.7.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.19"
  }
}
