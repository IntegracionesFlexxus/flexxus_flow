{
  "compilerOptions": {
    // Configuración básica de TypeScript para MVP
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting básico - TODO: Nivel 2 agregar más strict checks */
    "strict": true,
    "noUnusedLocals": false, // Por ahora permitimos vars sin usar
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases para imports más limpios */
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}