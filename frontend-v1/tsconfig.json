{
  "compilerOptions": {
    // Configuración básica de TypeScript para MVP
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting básico - TODO: Nivel 2 agregar más strict checks */
    "strict": false,
    "noUnusedLocals": false, // Por ahora permitimos vars sin usar
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "strictNullChecks": false,

    /* Path aliases para imports más limpios */
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@modules/*": ["modules/*"],
      "@services/*": ["services/*"],
      "@shared/*": ["shared/*"],
      "@utils/*": ["utils/*"],
      "@hooks/*": ["hooks/*"],
      "@stores/*": ["stores/*"],
      "@styles/*": ["styles/*"],
      "@assets/*": ["assets/*"],
      "@config/*": ["config/*"],
      "@navigation/*": ["navigation/*"],
      "@loading-states/*": ["loading-states/*"],
      "@error-handling/*": ["error-handling/*"],
      "@notifications/*": ["notifications/*"],

      // Centralized Roles and Permissions types (can use either alias)
      "@/modules/roles/types": ["modules/roles/types/index.ts"],
      "@/types/roles": ["modules/roles/types/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}