{
  "info": {
    "name": "Flexxus Flow Backend",
    "description": "Colección completa de endpoints del backend Flexxus Flow - Actualizada para pruebas de Login",
    "version": "2.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3004",
      "type": "string"
    },
    {
      "key": "apiUrl",
      "value": "{{baseUrl}}/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "company_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": ["{{baseUrl}}"],
              "path": ["api"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Test Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verificar status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Guardar tokens si el login es exitoso",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    ",
                  "    if (response.data && response.data.accessToken) {",
                  "        pm.collectionVariables.set(\"access_token\", response.data.accessToken);",
                  "        pm.collectionVariables.set(\"refresh_token\", response.data.refreshToken);",
                  "        ",
                  "        if (response.data.user) {",
                  "            pm.collectionVariables.set(\"user_id\", response.data.user.id);",
                  "        }",
                  "        ",
                  "        if (response.data.companies && response.data.companies[0]) {",
                  "            pm.collectionVariables.set(\"company_id\", response.data.companies[0].id);",
                  "        }",
                  "        ",
                  "        console.log(\"✅ Login exitoso - Tokens guardados\");",
                  "    }",
                  "} else {",
                  "    console.log(\"❌ Login fallido:\", pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Log del request para debugging",
                  "console.log(\"Enviando login request a:\", pm.request.url.toString());",
                  "console.log(\"Body:\", pm.request.body.raw);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@flexxus.com\",\n    \"password\": \"admin123\",\n    \"rememberMe\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/auth/login",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login con usuario admin de prueba.\n\nCredenciales:\n- Email: admin@flexxus.com\n- Password: admin123\n\nEste endpoint retorna:\n- accessToken\n- refreshToken\n- user (información del usuario)\n- companies (empresas del usuario)"
          }
        },
        {
          "name": "Login - Custom User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "if (response.data && response.data.accessToken) {",
                  "    pm.collectionVariables.set(\"access_token\", response.data.accessToken);",
                  "    pm.collectionVariables.set(\"refresh_token\", response.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"rememberMe\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/auth/login",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login con credenciales personalizadas"
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Limpiar tokens",
                  "pm.collectionVariables.set(\"access_token\", \"\");",
                  "pm.collectionVariables.set(\"refresh_token\", \"\");",
                  "pm.collectionVariables.set(\"user_id\", \"\");",
                  "pm.collectionVariables.set(\"company_id\", \"\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/auth/logout",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "if (response.data && response.data.accessToken) {",
                  "    pm.collectionVariables.set(\"access_token\", response.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/auth/refresh",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/auth/validate",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "validate"]
            },
            "description": "Valida si el token actual es válido"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/users/me",
              "host": ["{{apiUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/users",
              "host": ["{{apiUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/users/{{user_id}}",
              "host": ["{{apiUrl}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Get User Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/companies",
              "host": ["{{apiUrl}}"],
              "path": ["companies"]
            }
          }
        },
        {
          "name": "Switch Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"companyId\": \"{{company_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/companies/switch",
              "host": ["{{apiUrl}}"],
              "path": ["companies", "switch"]
            }
          }
        }
      ]
    },
    {
      "name": "Test Requests",
      "item": [
        {
          "name": "Test 401 Error",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/users/me",
              "host": ["{{apiUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Request sin token para probar error 401"
          }
        },
        {
          "name": "Test Invalid Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"invalid@example.com\",\n    \"password\": \"wrongpassword\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/auth/login",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Test con credenciales inválidas"
          }
        }
      ]
    }
  ]
}