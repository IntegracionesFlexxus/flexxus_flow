        {
          "name": "✨ Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generar email único para evitar duplicados",
                  "const timestamp = new Date().getTime();",
                  "const randomEmail = `user_${timestamp}@flexxus.com`;",
                  "pm.variables.set(\"random_email\", randomEmail);",
                  "",
                  "console.log(\"Email generado:\", randomEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    console.log(\"✅ Usuario creado:\", response);",
                  "} else {",
                  "    console.log(\"❌ Error:\", pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
