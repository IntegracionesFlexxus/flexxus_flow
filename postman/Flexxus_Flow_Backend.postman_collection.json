    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    ",
                  "    if (response.data && response.data.accessToken) {",
                  "        pm.collectionVariables.set(\"access_token\", response.data.accessToken);",
                  "        pm.collectionVariables.set(\"refresh_token\", response.data.refreshToken);",
                  "        ",
                  "        if (response.data.user) {",
                  "            pm.collectionVariables.set(\"user_id\", response.data.user.id);",
                  "        }",
                  "        ",
                  "        if (response.data.companies && response.data.companies[0]) {",
                  "            pm.collectionVariables.set(\"company_id\", response.data.companies[0].id);",
                  "        }",
                  "        ",
                  "        console.log(\"✅ Login exitoso - Tokens guardados\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@flexxus.com\",\n    \"password\": \"admin123\",\n    \"rememberMe\": false\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/auth/login",
              "host": ["{{apiUrl}}"],
              "path": ["auth", "login"]
            }
